{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "levelboard/results.schema.json",
  "title": "Levelboard-Ergebnisse",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "levels"],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "commit", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "title", "status", "checkedAt", "durationMs", "checks", "metrics"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "title": { "type": "string" },
        "status": { "enum": ["offen", "bestanden", "fehlgeschlagen", "gesperrt"] },
        "checkedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ok"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "ok": { "type": "boolean" }
            }
          }
        },
        "metrics": { "type": "object" }
      }
    }
  }
}
